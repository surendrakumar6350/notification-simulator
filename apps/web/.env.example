# Database
DB=mongodb+srv://username:password@cluster0.mongodb.net/mydatabase

# Redis
REDIS_URL=redis://default:password@redis-host:17957

# Environment
NODE_ENVV=development

# Worker Service
WORKER_URI=https://your-worker-service-url
WORKER_URI_DEV=http://localhost:5067
WORKER_SECRET=your-worker-secret

# Cloudflare Turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your-public-site-key
TURNSTILE_SECRET_KEY=your-secret-key

# JWT
JWT_SECRET_KEY=your-jwt-secret

# MailSender
MAILSENDER_API_KEY=your-mailsender-api-key
MAILSENDER_FROM_EMAIL=sender@example.com
MAILSENDER_TO_EMAIL=receiver@example.com

# Admin Panel
ADMIN_PANNEL_PASSWORD=your-admin-password

# Analytics Configuration (optional - only include if you want analytics)
# Google Analytics
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
NEXT_PUBLIC_GA_SCRIPT_URL=https://www.googletagmanager.com/gtag/js

# Umami Analytics
NEXT_PUBLIC_UMAMI_SCRIPT_URL=https://your-umami-instance.com/script.js
NEXT_PUBLIC_UMAMI_WEBSITE_ID=your-umami-website-id
